# Ajustes locales de Claude Code (por máquina; aquí viven las llaves de los MCP)
.claude/settings.local.json
**/.claude/settings.local.json
*.local.txt
*.local.sql
**/*.local.txt
**/*.local.sql

# Artefactos de deploy y respaldos comprimidos — no versionar
*_deploy_*.zip
*.rar

# Bejauha NO es de ToqueFlow: repo/proyecto aparte (plataforma/ con .env.local, media pesada, .ai 496MB)
Websites/Bejauha/

# Supabase CLI (cache / vínculo local)
**/supabase/.temp/

# Vassco: datos fiscales reales (facturas DIAN, RUT) — no publicar en GitHub
Vassco/*.zip
Vassco/Rut*.pdf

