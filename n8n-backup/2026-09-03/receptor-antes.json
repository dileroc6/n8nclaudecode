    {
      "id": "n-val",
      "name": "Recibir y validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ],
      "parameters": {
        "jsCode": "// Receptor multi-tenant de eventos de la plataforma Toque.\n// PILOTO: solo recibe, valida el secreto y hace ACK. NO envia ni escribe nada todavia.\nconst SECRET='tqf-bejauha-n8n-2026-9x7k2p'; // TODO mover a variable de entorno\nconst root=$input.first().json;\nconst headers=root.headers||{};\nconst sig=(headers['x-toque-signature']||headers['authorization']||'').toString();\nconst body=(root.body&&typeof root.body==='object')?root.body:{};\nconst event=(body.event||'').toString();\nconst event_id=(body.event_id||'').toString();\nconst company_slug=(body.company_slug||'').toString();\nconst valid=(sig===SECRET || sig==='Bearer '+SECRET);\nif(!valid){\n  return [{json:{ok:false,error:'unauthorized'}}];\n}\nconst conocidos=['ejecutar_campana','pago_fallido','recordatorio_ultima_clase','tracking_deudor'];\n// Aqui iran los handlers reales en go-live (por ahora solo ACK, sin acciones).\nreturn [{json:{ok:true,recibido:true,event,event_id,company_slug,event_conocido:conocidos.includes(event),nota:'PILOTO: recibido y validado, sin procesar (hold)'}}];"
      }
    },
