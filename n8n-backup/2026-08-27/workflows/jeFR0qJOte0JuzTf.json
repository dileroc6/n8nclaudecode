 regex: /^(\\d{4})\\s+FALTA\\s*INFO:\\s*(.+)$/is,    resultado: 'FALTA_INFO' },\n  { regex: /^(\\d{4})\\s+NO\\s*VIABLE[:\\s]*(.*)$/is,   resultado: 'NO_VIABLE'  }\n];\n\nlet sku = null, resultado = null, detalle = '';\nfor (const p of patterns) {\n  const m = text.match(p.regex);\n  if (m) { sku = m[1].padStart(4,'0'); resultado = p.resultado; detalle = (m[2]||'').trim(); break; }\n}\n\nif (!sku || !resultado) {\n  return [{ json: { _skip: true, rawText: text } }];\n}\n\nreturn [{ json: { sku, resultado, detalle, rawText: text, senderPhone: $json.senderPhone, pushName: $json.pushName } }];"}},{"id":"w2n06","name":"¿Mensaje reconocible?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1080,400],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ String(!$json._skip) }}","rightValue":"true","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}}},{"id":"w2n07","name":"Detener — mensaje no reconocible","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1300,260],"parameters":{}},{"id":"w2n08","name":"Buscar lead por SKU","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1300,400],"parameters":{"operation":"executeQuery","query":"SELECT id, sku, phone, name, language, estado FROM luxe_smile.leads WHERE sku = $1 LIMIT 1","options":{"queryReplacement":"={{ $json.sku }}"}},"credentials":{"postgres":{"id":"vzzTNppBFKg9XCiK","name":"PostgreSQL — LeadAI"}}},{"id":"w2n09","name":"¿Lead en revisión existe?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,400],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ String($json.id !== undefined && $json.id !== null) }}","rightValue":"true","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}}},{"id":"w2n10","name":"Detener — SKU no válido o estado incorr