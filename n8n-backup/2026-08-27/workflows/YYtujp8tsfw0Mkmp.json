{"updatedAt":"2026-07-07T14:43:42.214Z","createdAt":"2026-07-07T13:59:34.391Z","id":"YYtujp8tsfw0Mkmp","name":"Bejauha - Recordatorio Última Clase (Sheet)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"n-cron","name":"Cron 9am","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-1100,-40],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * *"}]}}},{"id":"n-hook","name":"Trigger prueba","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1100,160],"parameters":{"httpMethod":"GET","path":"bejauha-recordatorio-test","responseMode":"lastNode","options":{}},"webhookId":"bejauha-recordatorio-test-hook"},{"id":"n-read","name":"Leer Sheet","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-880,60],"parameters":{"authentication":"serviceAccount","resource":"sheet","operation":"read","documentId":{"__rl":true,"mode":"id","value":"1QEkn7Fg9jdh7qnqwWy_FvbWeXr7nrc_S0EcBtSzAFH8"},"sheetName":{"__rl":true,"mode":"name","value":"Hoja 1"},"options":{}},"credentials":{"googleApi":{"id":"kfmx1gj6KPrgmj2E","name":"BF - Sheets Service Account"}}},{"id":"n-detect","name":"Detectar candidatos","type":"n8n-nodes-base.code","typeVersion":2,"position":[-660,60],"parameters":{"jsCode":"// MODO_PRUEBA=true: detecta pero NO envia (solo lista). Cambiar a false para produccion.\nconst MODO_PRUEBA = true;\nconst ADMIN_GROUP = '120363409231703955@g.us'; // TODO confirmar grupo admin real de Bejauha\n\nconst rows = $('Leer Sheet').all().map(i => i.json);\nconst norm = s => (s||'').toString().toLowerCase().trim();\nconst tel57 = s => { let d=(s||'').toString().replace(/\\D/g,''); if(d.length===10) d='57'+d; return d; };\n\nconst cand = [];\nfor (const r of rows) {\n  const servicio = norm(r['Tipo de servicio']);\n  const saldoRaw = (r['Clases restantes']||'').toString().replace(/\\D/g,'');\n  const saldo = saldoRaw === '' ? null : parseInt(saldoRaw, 10);\n  if (servicio.startsWith('paquete') && saldo === 1) {\n    const nombre = ((r['Nombres']||'')+' '+(r['Apellidos']||'')).trim();\n    const primer = (r['Nombres']||'').toString().trim().split(/\\s+/)[0] || '';\n    cand.push({\n      telefono: tel57(r['Telefono']),\n      nombre,\n      mensaje_cliente: 'Hola ' + primer + ' 🌿 te queda 1 clase de tu paquete. Cuando quieras renovamos para que no pierdas el ritmo 💛'\n    });\n  }\n}\nconst admin_texto = cand.length\n  ? ('Recordatorio: ' + cand.length + ' persona(s) con 1 clase restante (se les avisó):\\n' + cand.map(c => '• ' + c.nombre + ' (' + c.telefono + ')').join('\\n'))\n  : '';\nreturn [{ json: { count: cand.length, candidatos: cand, admin_texto, admin_group: ADMIN_GROUP, enviar: (!MODO_PRUEBA && cand.length > 0), modo_prueba: MODO_PRUEBA } }];"}},{"id":"n-if","name":"Enviar?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-440,60],"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"loose","version":2,"leftValue":""},"combinator":"and","conditions":[{"id":"e1","leftValue":"={{ $json.enviar }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}]},"options":{}}},{"id":"n-split","name":"Split candidatos","type":"n8n-nodes-base.code","typeVersion":2,"position":[-220,-60],"parameters":{"jsCode":"const c = $('Detectar candidatos').first().json.candidatos || [];\nreturn c.map(x => ({ json: x }));"}},{"id":"n-send-cli","name":"Avisar cliente (Evolution)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[0,-60],"onError":"continueRegularOutput","parameters":{"method":"POST","url":"={{ $env.EVOLUTION_API_URL }}/message/sendText/dev-router","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.EVOLUTION_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $json.telefono }}\",\n  \"delay\": 1200,\n  \"linkPreview\": false,\n  \"text\": {{ JSON.stringify($json.mensaje_cliente) }}\n}","options":{"timeout":15000,"batching":{"batch":{"batchSize":1,"batchInterval":4000}}}},"disabled":true},{"id":"n-send-admin","name":"Avisar admin (Evolution)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[0,160],"onError":"continueRegularOutput","parameters":{"method":"POST","url":"={{ $env.EVOLUTION_API_URL }}/message/sendText/dev-router","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.EVOLUTION_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $('Detectar candidatos').first().json.admin_group }}\",\n  \"text\": {{ JSON.stringify($('Detectar candidatos').first().json.admin_texto) }}\n}","options":{"timeout":15000}},"disabled":true},{"id":"n-resp","name":"Respuesta prueba","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-220,200],"parameters":{"assignments":{"assignments":[{"id":"s1","name":"count","value":"={{ $('Detectar candidatos').first().json.count }}","type":"number"},{"id":"s2","name":"modo_prueba","value":"={{ $('Detectar candidatos').first().json.modo_prueba }}","type":"boolean"},{"id":"s3","name":"candidatos","value":"={{ JSON.stringify($('Detectar candidatos').first().json.candidatos) }}","type":"string"},{"id":"s4","name":"admin_texto","value":"={{ $('Detectar candidatos').first().json.admin_texto }}","type":"string"}]},"options":{}}}],"connections":{"Cron 9am":{"main":[[{"node":"Leer Sheet","type":"main","index":0}]]},"Trigger prueba":{"main":[[{"node":"Leer Sheet","type":"main","index":0}]]},"Leer Sheet":{"main":[[{"node":"Detectar candidatos","type":"main","index":0}]]},"Detectar candidatos":{"main":[[{"node":"Enviar?","type":"main","index":0}]]},"Enviar?":{"main":[[{"node":"Split candidatos","type":"main","index":0},{"node":"Avisar admin (Evolution)","type":"main","index":0}],[{"node":"Respuesta prueba","type":"main","index":0}]]},"Split candidatos":{"main":[[{"node":"Avisar clien