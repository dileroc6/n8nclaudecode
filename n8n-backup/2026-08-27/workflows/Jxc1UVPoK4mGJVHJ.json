{"updatedAt":"2026-04-21T21:50:09.277Z","createdAt":"2026-04-19T03:11:11.272Z","id":"Jxc1UVPoK4mGJVHJ","name":"Luxe Smile — Confirmación de Pago Manual","description":null,"active":true,"isArchived":false,"nodes":[{"id":"w5n01","name":"Webhook WhatsApp Grupos","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[200,400],"parameters":{},"notes":"Activado por WF-01 cuando llega mensaje del grupo Confirmación de Pagos"},{"id":"w5n02","name":"Extraer datos del webhook","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,400],"parameters":{"jsCode":"// Data already processed by WF-01's 'Extraer datos del mensaje' node\nconst remoteJid = $json.remoteJid || '';\nconst fromMe = false; // group admin messages are never fromMe\nconst messageText = $json.messageText || '';\nconst hasMedia = $json.hasMedia || false;\nconst mediaUrl = $json.mediaUrl || '';\n\nconst grupoPagosId = $env['WHATSAPP_GROUP_PAGOS'] || '';\nconst esGrupoPagos = remoteJid === grupoPagosId || remoteJid.includes('@g.us');\n\nreturn [{ json: {\n  remoteJid, fromMe, messageText, hasMedia, mediaUrl,\n  esGrupoPagos,\n  rawBody: JSON.stringify($json)\n}}];"}},{"id":"w5n03","name":"¿Es del grupo de pagos?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,400],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $json.esGrupoPagos }}","rightValue":true,"operator":{"type":"boolean","operation":"equal"}},{"id":"c2","leftValue":"={{ $json.fromMe }}","rightValue":false,"operator":{"type":"boolean","operation":"equal"}}],"combinator":"and"},"options":{}}},{"id":"w5n04","name":"Ignorar — no es del grupo de pagos","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[860,280],"parameters":{}},{"id":"w5n05","name":"¿Tiene imagen (comprobante)?","type":"n8n-nodes-base.if","typeVersion":2,"position":[860,400],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $json.hasMedia }}","rightValue":true,"operator":{"type":"boolean","operation":"equal"}}],"combinator":"and"},"options":{}}},{"id":"w5n06","name":"Parsear SKU y acción del texto","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,500],"parameters":{"jsCode":"// Formato esperado del admin en el grupo: [SKU] CONFIRMADO o [SKU] RECHAZADO: motivo\nconst text = ($json.messageText || '').trim();\n\n// Match: [0042] CONFIRMADO o 0042 CONFIRMADO o 0042 RECHAZADO: motivo\nconst match = text.match(/[\\[\\(]?(\\d{4})[\\]\\)]?\\s+(CONFIRMADO|RECHAZADO)(?:[:\\s]+(.*))?/i);\n\nif (!match) {\n  return [{ json: { skuEncontrado: false, rawText: text } }];\n}\n\nconst sku = match[1].padStart(4, '0');\nconst accion = match[2].toUpperCase();\nconst motivo = (match[3] || '').trim();\n\nreturn [{ json: {\n  skuEncontrado: true,\n  leadSku: sku,\n  accion,\n  motivo,\n  rawText: text\n}}];"}},{"id":"w5n07","name":"Reenviar comprobante al grupo de pagos con contexto","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,300],"parameters":{"jsCode":"// Extraer SKU del caption de la imagen si viene del lead via WF-01\n// El caption debería tener el SKU embebido por WF-01\nconst caption = $json.messageText || '';\nconst skuMatch = caption.match(/SKU[:\\s]*(\\d{4})/i) || caption.match(/(\\d{4})/);\nconst leadSku = skuMatch ? skuMatch[1].padStart(4,'0') : 'DESCONOCIDO';\n\nreturn [{ json: {\n  leadSku,\n  mediaUrl: $json.mediaUrl,\n  caption,\n  textoParaGrupo: `💰 COMPROBANTE DE PAGO RECIBIDO\\nSKU: ${leadSku}\\n\\nEl lead envió un comprobante. Verificar y responder:\\n✅ ${leadSku} CONFIRMADO\\n❌ ${leadSku} RECHAZADO: [motivo]`\n}}];"}},{"id":"w5n08","name":"Enviar notificación al grupo de pagos","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1300,300],"parameters":{"method":"POST","url":"={{ $env['EVOLUTION_API_URL'] }}/message/sendText/{{ $env['EVOLUTION_INSTANCE_LUXE'] }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"number","value":"={{ $env['WHATSAPP_GROUP_PAGOS'] }}"},{"name":"text","value":"={{ $json.textoParaGrupo }}"}]},"options":{}},"credentials":{"httpHeaderAuth":{"id":"QT0zn550ysJh8VpI","name":"Evolution API — Luxe Smile"}}},{"id":"w5n09","name":"¿SKU encontrado en respuesta?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1300,500],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $json.skuEncontrado }}","rightValue":true,"operator":{"type":"boolean","operation":"equal"}}],"combinator":"and"},"options":{}}},{"id":"w5n10","name":"Ignorar — texto sin SKU válido","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1520,380],"parameters":{}},{"id":"w5n11","name":"Buscar lead por SKU","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1520,520],"parameters":{"operation":"executeQuery","query":"SELECT id, sku, phone, name, language, estado FROM luxe_smile.leads WHERE sku = $1 AND estado = 'pago_pendiente' LIMIT 1","options":{"queryReplacement":"={{ $json.leadSku }}"}},"credentials":{"postgres":{"id":"vzzTNppBFKg9XCiK","name":"PostgreSQL — LeadAI"}}},{"id":"w5n12","name":"¿Lead encontrado?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1740,520],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $json.id !== undefined && $json.id !== null }}","rightValue":true,"operator":{"type":"boolean","operation":"equal"}}],"combinator":"and"},"options":{}}},{"id":"w5n13","name":"Detener — lead no encontrado","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1960,400],"parameters":{}},{"id":"w5n14","name":"¿Confirmado o rechazado?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1960,540],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"c1","leftValue":"={{ $('Parsear SKU y acción del texto').item.json.accion }}","rightValue":"CONFIRMADO","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}}},{"id":"w5n15","name":"Registrar pago manual en DB","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[2180,440],"parameters":{"operation":"executeQuery","query":"INSERT INTO luxe_smile.pagos (lead_sku, metodo, monto_usd, estado, confirmado_at) VALUES ($1, 'manual', 500, 'confirmado', NOW()) ON CONFLICT DO NOTHING","options":{"queryReplacement":"={{ $json.sku }}"}},"credentials":{"postgres":{"id":"vzzTNppBFKg9XCiK","name":"PostgreSQL — LeadAI"}}},{"id":"w5n16","name":"Actualizar lead a pago confirmado","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[2400,440],"parameters":{"operation":"executeQuery","query":"UPDATE luxe_smile.leads SET estado = 'pago_confirmado', deposit_paid = TRUE, payment_method = 'manual', pago_at = NOW() WHERE sku = $1","options":{"queryReplacement":"={{ $json.sku }}"}},"credentials":{"postgres":{"id":"vzzTNppBFKg9XCiK","name":"PostgreSQL — LeadAI"}}},{"id":"w5n17","name":"Preparar mensaje bienvenida (pago confirmado)","type":"n8n-nodes-base.code","typeVersion":2,"position":[2620,440],"parameters":{"jsCode":"const lead = $('Buscar lead por SKU').item.json;\nconst isEs = lead.language === 'es';\nconst msg = isEs\n  ? `¡Hola ${lead.name || 'ahí'}! 🎉 ¡Confirmamos la recepción de tu pago!\\n\\n¡Bienvenid@ a la familia Luxe Smile! 😁✨\\n\\nEn los próximos minutos te contactaremos para confirmar los detalles de tu viaje.`\n  : `Hi ${lead.name || 'there'}! 🎉 We have confirmed receipt of your payment!\\n\\nWelcome to the Luxe Smile family! 😁✨\\n\\nWe'll be in touch shortly to confirm your travel details.`;\nreturn [{ json: { ...lead, mensajeParaLead: msg } }];"}},{"id":"w5