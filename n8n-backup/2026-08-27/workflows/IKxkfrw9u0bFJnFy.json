{"updatedAt":"2026-06-23T03:18:12.459Z","createdAt":"2026-06-23T03:16:22.186Z","id":"IKxkfrw9u0bFJnFy","name":"Bejauha - Sandbox Page (HTML)","description":null,"active":true,"isArchived":false,"nodes":[{"id":"node-page-hook","name":"Webhook page","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-400,0],"parameters":{"httpMethod":"GET","path":"bejauha-sandbox","responseMode":"responseNode","options":{}},"webhookId":"bejauha-sandbox-page"},{"id":"node-page-resp","name":"Servir HTML","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[-180,0],"parameters":{"respondWith":"text","responseBody":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Bejauha · Sandbox de Agentes</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --sage:#7c8a6f; --sage-dark:#5f6c54; --sage-soft:#aebfa0;\n    --cream:#f6f3ea; --cream-2:#efe9db; --ink:#3a3f36; --muted:#8b9182;\n    --bot:#ffffff; --user:#dfe8d4; --sys:#f3e7cf; --line:#e3ddcd;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;font-family:'Poppins',sans-serif;background:var(--cream);color:var(--ink);\n    height:100vh;display:flex;flex-direction:column}\n  header{background:var(--sage);color:var(--cream);padding:14px 22px;display:flex;align-items:center;gap:14px;\n    box-shadow:0 2px 10px rgba(0,0,0,.08)}\n  header h1{margin:0;font-weight:700;font-size:1.15rem;letter-spacing:.3px}\n  header .pf{font-family:'Playfair Display',serif;font-style:italic;font-weight:600;opacity:.92;font-size:1.05rem}\n  header .tag{margin-left:auto;font-size:.72rem;background:rgba(255,255,255,.18);padding:4px 10px;border-radius:20px}\n  .bar{display:flex;gap:10px;align-items:center;padding:12px 22px;background:var(--cream-2);border-bottom:1px solid var(--line);flex-wrap:wrap}\n  .seg{display:flex;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}\n  .seg button{border:0;background:transparent;padding:8px 16px;font-family:inherit;font-weight:600;font-size:.85rem;cursor:pointer;color:var(--muted)}\n  .seg button.on{background:var(--sage);color:#fff}\n  .bar label{font-size:.78rem;color:var(--muted);font-weight:500}\n  .bar input{font-family:inherit;border:1px solid var(--line);border-radius:10px;padding:7px 10px;font-size:.82rem;width:120px;background:#fff}\n  .bar .spacer{margin-left:auto}\n  .btn-reset{border:1px solid var(--sage);background:#fff;color:var(--sage-dark);font-family:inherit;font-weight:600;\n    padding:8px 14px;border-radius:10px;cursor:pointer;font-size:.82rem}\n  .btn-reset:hover{background:var(--sage);color:#fff}\n  #chat{flex:1;overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:12px}\n  .msg{max-width:74%;padding:11px 15px;border-radius:16px;font-size:.92rem;line-height:1.45;white-space:pre-wrap;\n    box-shadow:0 1px 3px rgba(0,0,0,.05);animation:pop .18s ease}\n  @keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n  .msg.user{align-self:flex-end;background:var(--user);border-bottom-right-radius:4px}\n  .msg.bot{align-self:flex-start;background:var(--bot);border-bottom-left-radius:4px}\n  .msg.system{align-self:center;background:var(--sys);color:#7a6326;font-size:.8rem;border-radius:10px;max-width:88%;text-align:center}\n  .msg .who{display:block;font-size:.66rem;font-weight:600;text-transform:uppercase;letter-spacing:.5px;opacity:.6;margin-bottom:3px}\n  .typing{align-self:flex-start;color:var(--muted);font-size:.8rem;font-style:italic;padding:4px 8px}\n  .empty{margin:auto;text-align:center;color:var(--muted);max-width:360px}\n  .empty .pf{font-family:'Playfair Display',serif;font-style:italic;font-size:1.4rem;color:var(--sage);display:block;margin-bottom:8px}\n  footer{padding:14px 22px;background:var(--cream-2);border-top:1px solid var(--line);display:flex;gap:10px}\n  footer textarea{flex:1;resize:none;font-family:inherit;font-size:.92rem;border:1px solid var(--line);border-radius:14px;\n    padding:11px 14px;height:46px;background:#fff}\n  footer button{background:var(--sage);color:#fff;border:0;border-radius:14px;padding:0 22px;font-family:inherit;\n    font-weight:600;cursor:pointer;font-size:.9rem}\n  footer button:disabled{opacity:.5;cursor:default}\n</style>\n</head>\n<body>\n  <header>\n    <h1>Bejauha <span class=\"pf\">· Sandbox de Agentes</span></h1>\n    <span class=\"tag\">canal de pruebas — no pasa por WhatsApp</span>\n  </header>\n\n  <div class=\"bar\">\n    <div class=\"seg\" id=\"seg\">\n      <button data-ag=\"3\" class=\"on\">🌿 Inbound (cliente)</button>\n      <button data-ag=\"2\">🛠️ Admin (clases)</button>\n    </div>\n    <label>Tel. prueba</label>\n    <input id=\"tel\" value=\"99999999\">\n    <div class=\"spacer\"></div>\n    <button class=\"btn-reset\" id=\"reset\">↺ Reiniciar prueba</button>\n  </div>\n\n  <div id=\"chat\">\n    <div class=\"empty\" id=\"empty\">\n      <span class=\"pf\">Prueba la lógica sin enviar un solo WhatsApp</span>\n      Escribe como si fueras un cliente (o un administrador) y mira cómo responde el agente real, con saldos y datos reales en un entorno aislado.\n    </div>\n  </div>\n\n  <footer>\n    <textarea id=\"input\" placeholder=\"Escribe un mensaje…\"></textarea>\n    <button id=\"send\">Enviar</button>\n  </footer>\n\n<script>\nconst BASE = \"https://n8n.srv1398596.hstgr.cloud/webhook\";\nlet agente = 3;\nlet after = 0;\nlet session = \"portal-\" + Math.random().toString(36).slice(2, 10);\nlet polling = null;\n\nconst chat = document.getElementById('chat');\nconst input = document.getElementById('input');\nconst sendBtn = document.getElementById('send');\nconst telEl = document.getElementById('tel');\nconst empty = document.getElementById('empty');\n\ndocument.querySelectorAll('#seg button').forEach(b => b.onclick = () => {\n  document.querySelectorAll('#seg button').forEach(x => x.classList.remove('on'));\n  b.classList.add('on');\n  agente = parseInt(b.dataset.ag, 10);\n});\n\nfunction addMsg(rol, texto, ag){\n  if(empty) empty.style.display = 'none';\n  const d = document.createElement('div');\n  d.className = 'msg ' + rol;\n  const who = rol === 'user' ? 'Tú' : rol === 'system' ? 'Sistema (simulado)' : (ag === 2 ? 'Agente Admin' : 'Beja');\n  d.innerHTML = '<span class=\"who\"></span>';\n  d.querySelector('.who').textContent = who;\n  d.appendChild(document.createTextNode(texto));\n  chat.appendChild(d);\n  chat.scrollTop = chat.scrollHeight;\n}\n\nfunction showTyping(on){\n  let t = document.getElementById('typing');\n  if(on && !t){\n    t = document.createElement('div'); t.id = 'typing'; t.className = 'typing';\n    t.textContent = 'escribiendo…'; chat.appendChild(t); chat.scrollTop = chat.scrollHeight;\n  } else if(!on && t){ t.remove(); }\n}\n\nasync function poll(){\n  try{\n    const r = await fetch(`${BASE}/bejauha-test-poll?session_id=${encodeURIComponent(session)}&after=${after}`);\n    const data = await r.json();\n    const msgs = (data && data.mensajes) || [];\n    for(const m of msgs){\n      if(m.id > after) after = m.id;\n      if(m.rol === 'user') continue; // las del usuario ya las pintamos localmente\n      showTyping(false);\n      addMsg(m.rol, m.texto, m.agente);\n    }\n  }catch(e){ /* silencio */ }\n}\n\nasync function send(){\n  const texto = input.value.trim();\n  if(!texto) return;\n  addMsg('user', texto, agente);\n  input.value = '';\n  sendBtn.disabled = true;\n  showTyping(true);\n  try{\n    await fetch(`${BASE}/bejauha-test-chat`, {\n      method:'POST', headers:{'Content-Type':'application/json'},\n      body: JSON.stringify({ agente, session_id: session, telefono: telEl.value.trim() || '99999999', texto })\n    });\n    await poll();\n  }catch(e){ showTyping(false); addMsg('system','⚠️ Error de conexión con el sandbox.'); }\n  showTyping(false);\n  sendBtn.disabled = false;\n  input.focus();\n}\n\nasync function reset(){\n  if(!confirm('¿Reiniciar la prueba? Se borra la conversación y se restaura el contacto de prueba (saldo, estado).')) return;\n  try{\n    await fetch(`${BASE}/bejauha-test-reset`, {\n      method:'POST', headers:{'Content-Type':'application/json'},\n      body: JSON.stringify({ session_id: session, telefono: telEl.value.trim() || '99999999' })\n    });\n  }catch(e){}\n  chat.querySelectorAll('.msg, #typing').forEach(n => n.remove());\n  after = 0;\n  session = \"portal-\" + Math.random().toString(36).slice(2, 10);\n  empty.style.display = '';\n}\n\nsendBtn.onclick = send;\ninput.addEventListener('keydown', e => { if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(); }});\ndocument.getElementById('reset').onclick = reset;\npolling = setInterval(poll, 2000); // poll de respaldo para burbujas con delay\n</script>\n</body>\n</html>\n","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}}}}],"connections":{"Webhook page":{"main":[[{"node":"Servir HTML","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":null,"versionId":"d593bf6b-c449-43d3-9c21-8627ec5bd11b","activeVersionId":"d593bf6b-c449-43d3-9c21-8627ec5bd11b","versionCounter":6,"triggerCount":1,"shared":[{"updatedAt":"2026-06-23T03:16:22.189Z","createdAt":"2026-06-23T03:16:22.189Z","role":"workflow:owner","workflowId":"IKxkfrw9u0bFJnFy","projectId":"rZRkeAm6GVLmUxof","project":{"updatedAt":"2026-02-19T01:59:56.136Z","createdAt":"2026-02-19T01:58:26.855Z","id":"rZRkeAm6GVLmUxof","name":"Ferney Rojas <feruroc@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"6946a55e-46ec-4681-8c93-c318c39503c8"}}],"tags":[],"activeVersion":{"updatedAt":"2026-06-23T03:18:12.461Z","createdAt":"2026-06-23