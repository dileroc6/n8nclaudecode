); }\n  showTyping(false);\n  sendBtn.disabled = false;\n  input.focus();\n}\n\nasync function reset(){\n  if(!confirm('¿Reiniciar la prueba? Se borra la conversación y se restaura el contacto de prueba (saldo, estado).')) return;\n  try{\n    await fetch(`${BASE}/bejauha-test-reset`, {\n      method:'POST', headers:{'Content-Type':'application/json'},\n      body: JSON.stringify({ session_id: session, telefono: telEl.value.trim() || '99999999' })\n    });\n  }catch(e){}\n  chat.querySelectorAll('.msg, #typing').forEach(n => n.remove());\n  after = 0;\n  session = \"portal-\" + Math.random().toString(36).slice(2, 10);\n  empty.style.display = '';\n}\n\nsendBtn.onclick = send;\ninput.addEventListener('keydown', e => { if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(); }});\ndocument.getElementById('reset').onclick = reset;\npolling = setInterval(poll, 2000); // poll de respaldo para burbujas con delay\n</script>\n</body>\n</html>\n","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}}}}],"connections":{"Webhook page":{"main":[[{"node":"Servir HTML","type":"main","index":0}]]}},"authors":"Ferney Rojas","name":null,"description":null,"autosaved":false,"workflowPublishHistory":[{"createdAt":"2026-06-23T03:18:12.523Z","id":2449,"workflowId":"IKxkfrw9u0bFJnFy","versionId":"d593bf6b-c449-43d3-9c21-8627ec5bd11b","event":"activated","userId":"6946a55e-46ec-4681-8c93-c318c39503c8"},{"createdAt":"2026-06-23T03:18:12.501Z","id":2448,"workflowId":"IKxkfrw9u0bFJnFy","versionId":"d593bf6b-c449-43d3-9c21-8627ec5bd11b","event":"deactivated","userId":"6946a55e-46ec-4681-8c93-c318c39503c8"}]}}