{"updatedAt":"2026-05-06T02:06:32.616Z","createdAt":"2026-05-06T02:02:21.616Z","id":"M0Uqiu8ggudqtqDh","name":"BF - WF-Diag - GSC Coverage Check (TEMP)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"diag-001","name":"Webhook GSC Coverage","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,300],"parameters":{"httpMethod":"POST","path":"gsc-coverage-diag","responseMode":"responseNode","options":{}},"webhookId":"d11aa3f4-ca69-4aec-bb21-e16a703c0ea1"},{"id":"diag-002","name":"Build Date Range","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const today = new Date();\nconst fmt = d => d.toISOString().split('T')[0];\nconst daysAgo = (n) => { const d = new Date(today); d.setDate(d.getDate() - n); return fmt(d); };\nconst body = {\n  startDate: daysAgo(92),\n  endDate: daysAgo(2),\n  dimensions: ['page'],\n  rowLimit: 5000,\n  dataState: 'final'\n};\nreturn [{ json: { gsc_query_json: JSON.stringify(body), startDate: body.startDate, endDate: body.endDate } }];"}},{"id":"diag-003","name":"GSC Query Pages","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,300],"parameters":{"method":"POST","url":"https://searchconsole.googleapis.com/webmasters/v3/sites/https%3A%2F%2Fbigotesfelinos.com%2F/searchAnalytics/query","authentication":"predefinedCredentialType","nodeCredentialType":"googleOAuth2Api","sendBody":true,"specifyBody":"json","jsonBody":"={{ $json.gsc_query_json }}","options":{}},"credentials":{"googleOAuth2Api":{"id":"XWbfIBmitmx1uByl","name":"BF - Google OAuth"}}},{"id":"diag-004","name":"Format Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const resp = $input.first().json;\nconst meta = $('Build Date Range').first().json;\nconst rows = (resp.rows || []).map(r => ({\n  url: r.keys[0],\n  imp: r.impressions,\n  clk: r.clicks,\n  ctr: Number((r.ctr * 100).toFixed(2)),\n  pos: Number(r.position.toFixed(1))\n}));\nconst totalImp = rows.reduce((s, r) => s + r.imp, 0);\nconst totalClk = rows.reduce((s, r) => s + r.clk, 0);\nrows.sort((a, b) => b.imp - a.imp);\nreturn [{\n  json: {\n    period: { startDate: meta.startDate, endDate: meta.endDate },\n    total_urls_with_impressions: rows.length,\n    total_impressions: totalImp,\n    total_clicks: totalClk,\n    urls: rows\n  }\n}];"}},{"id":"diag-005","name":"Respond to Webhook","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[880,300],"parameters":{"respondWith":"json","responseBody":"={{ $json }}","options":{}}}],"connections":{"Webhook GSC Coverage":{"main":[[{"node":"Build Date Range","type":"main","index":0}]]},"Build Date Range":{"main":[[{"node":"GSC Query Pages","type":"main","index":0}]]},"GSC Query Pages":{"main":[[{"node":"Format Response","type":"main","index":0}]]},"Format Response":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","timezone":"America/Bogota"},"staticData":null,"meta":null,"pinData":null,"versionId":"95b01ae1-fcae-450b-8b7e-4cfcba5b8da1","activeVersionId":null,"versionCounter":8,"triggerCount":1,"shared":[{"updatedAt":"2026-05-06T02:02:21.620Z","createdAt":"2026-05-06T02:02:21.620Z","role":"workflow:owner","workflowId":"M0Uqiu8ggudqtqDh","projectId":"rZRkeAm6GVLmUxof","project":{"updatedAt":"2026-02-19T01:59:56.136Z","createdAt":"2026-02-19T01:58:26.855Z","id":"rZRkeAm6GVLmUxof","name":"Ferney Rojas <feruroc@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"6946a55e-46ec-4681-8c93-c318c39503c8"}}],"tags":[],"activeVersion":null}