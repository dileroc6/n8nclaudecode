{"updatedAt":"2026-05-02T01:48:50.000Z","createdAt":"2026-02-20T14:37:06.435Z","id":"vinxf9fWxIDIbTk2","name":"Agente Ferretería Ya","description":null,"active":false,"isArchived":true,"nodes":[{"parameters":{"httpMethod":"POST","path":"nico-chat","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"a153bf47-c4f2-42dd-8fca-175513edf414","name":"Webhook","webhookId":"cc7ddb69-9bee-4468-8a3d-733b6b254ad2"},{"parameters":{"options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[752,0],"id":"6c0ac863-33f5-4f70-b295-470822e20d8e","name":"Respond to Webhook"},{"parameters":{"assignments":{"assignments":[{"id":"274c7da6-a397-46a4-bb4d-539f60eeb027","name":"reply","value":"Hola, soy Nico. ¿Qué producto necesitas?","type":"string"},{"id":"24c274d3-0f88-46cb-92d2-155a201b3835","name":"links","value":"[]","type":"array"},{"id":"3fb25425-0e3c-4313-9550-447295423bcf","name":"followups","value":"=[\"¿Para qué lo vas a usar?\"]","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[512,-16],"id":"2605d199-7f0c-40ab-b62d-04ad9e301a5d","name":"Edit Fields"},{"parameters":{"url":"https://ferreteriaya.com.co/wp-json/wc/v3/products","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"search","value":"={{$node[\"Webhook\"].json.body.message}}"},{"name":"per_page","value":"5"},{"name":"status","value":"publish"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[208,0],"id":"6f19fdfc-d3cb-4de8-bd22-fa223060ae00","name":"HTTP Request","credentials":{"httpBasicAuth":{"id":"2I7Z6kwiTbYWPoVT","name":"Woocommerce Ferretería Api"}}},{"parameters":{"jsCode":"const query = $node[\"Webhook\"].json.body?.message ?? \"\";\nconst products = $input.all().map(i => i.json);\n\n// toma máximo 5 resultados\nconst top = products.slice(0, 5);\n\n// arma links clicables\nconst links = top.map(p => ({\n  title: p.name,\n  url: p.permalink,\n}));\n\nlet reply = \"\";\nif (top.length === 0) {\n  reply = `No encontré productos para \"${query}\". ¿Puedes decirme marca o referencia?`;\n} else {\n  const list = top.map((p, idx) => `${idx + 1}) ${p.name}`).join(\"\\n\");\n  reply =\n`Encontré ${top.length} opciones para \"${query}\":\n${list}\n\n¿Cuál te interesa? (puedes decirme el número)`;\n}\n\nreturn [\n  {\n    json: {\n      reply,\n      links,\n      followups: [\"¿Para qué lo vas a usar?\", \"¿Tienes un presupuesto aproximado?\"],\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[528,144],"id":"9c9e12a0-39fc-4779-9029-a5cfa3bef80a","name":"Code in JavaScript"}],"connections":{"Webhook":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"Edit Fields":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]},"HTTP Request":{"main":[[{"node":"Code in JavaScript","type":"main","index":0},{"node":"Edit Fields","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"meta":null,"pinData":{},"versionId":"92965e44-e914-4e2d-a2cd-2f514c25ae44","activeVersionId":null,"versionCounter":64,"triggerCount":0,"shared":[{"updatedAt":"2026-02-20T14:37:06.440Z","createdAt":"2026-02-20T14:37:06.440Z","role":"workflow:owner","workflowId":"vinxf9fWxIDIbTk2","projectId":"rZRkeAm6GVLmUxof","project":{"updatedAt":"2026-02-19T01:59:56.136Z","createdAt":"2026-02-19T01:58:26.855Z","id":"rZRkeAm6GVLmUxof","name":"Ferney Rojas <feruroc@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"6946a55e-46ec-4681-8c93-c318c39503c8"}}],"tags":[],"activeVersion":null}