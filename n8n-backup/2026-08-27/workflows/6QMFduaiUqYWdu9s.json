{"updatedAt":"2026-06-30T20:49:33.708Z","createdAt":"2026-06-30T20:49:20.496Z","id":"6QMFduaiUqYWdu9s","name":"Bejauha - Panel Clientes (Sheet)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"p-data","name":"Webhook datos","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-600,0],"parameters":{"httpMethod":"GET","path":"bejauha-panel-data","responseMode":"lastNode","options":{"allowedOrigins":"*"}},"webhookId":"bejauha-panel-data-hook"},{"id":"p-read","name":"Leer Sheet","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-400,0],"parameters":{"authentication":"serviceAccount","resource":"sheet","operation":"read","documentId":{"__rl":true,"mode":"id","value":"1QEkn7Fg9jdh7qnqwWy_FvbWeXr7nrc_S0EcBtSzAFH8"},"sheetName":{"__rl":true,"mode":"name","value":"Hoja 1"},"options":{}},"credentials":{"googleApi":{"id":"kfmx1gj6KPrgmj2E","name":"BF - Sheets Service Account"}}},{"id":"p-group","name":"Agrupar","type":"n8n-nodes-base.code","typeVersion":2,"position":[-200,0],"parameters":{"jsCode":"const rows = $input.all().map(i=>i.json).filter(r => ((r['Nombres']||'').toString().trim()) || ((r['Telefono']||'').toString().trim()));\nconst t = s => (s||'').toString().trim();\nconst paquetes=[], otros=[]; const resumen={};\nfor(const r of rows){\n  const tipo = t(r['Tipo de servicio']) || '(sin servicio)';\n  resumen[tipo]=(resumen[tipo]||0)+1;\n  const base={ nombre:((r['Nombres']||'')+' '+(r['Apellidos']||'')).trim(), telefono:t(r['Telefono']), lead:t(r['Tipo de Lead']), seguimiento:t(r['Seguimiento']), ultimo:t(r['Fecha de ultimo contacto']) };\n  if(tipo.toLowerCase()==='paquete'){ paquetes.push({...base, clases: parseInt((r['Clases restantes']||'0').toString().replace(/\\D/g,'')||'0',10)}); }\n  else { otros.push({...base, tipo}); }\n}\nreturn [{ json: { paquetes, otros, resumen } }];"}},{"id":"p-page","name":"Webhook pagina","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-600,220],"parameters":{"httpMethod":"GET","path":"bejauha-panel","responseMode":"responseNode","options":{}},"webhookId":"bejauha-panel-page-hook"},{"id":"p-html","name":"Servir HTML","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[-400,220],"parameters":{"respondWith":"text","responseBody":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Bejauha · Panel de Clientes</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{ --sage:#7c8a6f; --sage-dark:#5f6c54; --cream:#f6f3ea; --cream-2:#efe9db;\n    --ink:#3a3f36; --muted:#8b9182; --line:#e3ddcd; --warn:#c98a2b; --danger:#c0533b; }\n  *{box-sizing:border-box}\n  body{margin:0;font-family:'Poppins',sans-serif;background:var(--cream);color:var(--ink)}\n  header{background:var(--sage);color:var(--cream);padding:16px 26px;display:flex;align-items:center;gap:14px}\n  header h1{margin:0;font-weight:700;font-size:1.2rem}\n  header .pf{font-family:'Playfair Display',serif;font-style:italic;font-weight:600;opacity:.92}\n  header button{margin-left:auto;background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:20px;\n    padding:7px 16px;font-family:inherit;font-weight:600;cursor:pointer;font-size:.82rem}\n  .wrap{padding:24px 26px;max-width:1200px;margin:0 auto}\n  .cards{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px}\n  .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 18px;min-width:120px;flex:1}\n  .card .n{font-size:1.8rem;font-weight:700;color:var(--sage-dark)}\n  .card .l{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}\n  h2{font-family:'Playfair Display',serif;font-style:italic;font-weight:600;color:var(--sage-dark);margin:26px 0 12px}\n  table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}\n  th,td{text-align:left;padding:11px 14px;font-size:.88rem;border-bottom:1px solid var(--line)}\n  th{background:var(--cream-2);font-weight:600;color:var(--sage-dark);font-size:.74rem;text-transform:uppercase;letter-spacing:.5px}\n  tr:last-child td{border-bottom:0}\n  .pill{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.72rem;font-weight:600}\n  .pill.cli{background:#e3ece0;color:var(--sage-dark)} .pill.cal{background:#f7ddd5;color:var(--danger)}\n  .pill.tib{background:#fbeccd;color:var(--warn)} .pill.fri{background:#e6eaf0;color:#6b7280}\n  .saldo{font-weight:700} .saldo.low{color:var(--danger)} .saldo.mid{color:var(--warn)}\n  .filter{margin:0 0 10px}.filter select{font-family:inherit;border:1px solid var(--line);border-radius:10px;padding:7px 10px;font-size:.84rem;background:#fff}\n  .muted{color:var(--muted)} .empty{color:var(--muted);padding:18px;text-align:center}\n  .ts{font-size:.72rem;color:var(--muted);margin-top:10px}\n</style>\n</head>\n<body>\n  <header>\n    <h1>Bejauha <span class=\"pf\">· Panel de Clientes</span></h1>\n    <button id=\"refresh\">↻ Actualizar</button>\n  </header>\n  <div class=\"wrap\">\n    <div class=\"cards\" id=\"cards\"></div>\n\n    <h2>Clientes de Paquete</h2>\n    <div id=\"paquetes\"></div>\n\n    <h2>Otros contactos</h2>\n    <div class=\"filter\">\n      <select id=\"fTipo\"><option value=\"\">Todos los servicios</option></select>\n      <select id=\"fLead\"><option value=\"\">Todos los leads</option></select>\n    </div>\n    <div id=\"otros\"></div>\n    <div class=\"ts\" id=\"ts\"></div>\n  </div>\n\n<script>\nconst DATA = \"https://n8n.srv1398596.hstgr.cloud/webhook/bejauha-panel-data\";\nlet state = { paquetes:[], otros:[], resumen:{} };\n\nfunction pill(lead){\n  const l=(lead||'').toLowerCase();\n  const c = l==='cliente'?'cli':l==='caliente'?'cal':l==='tibio'?'tib':l==='frio'?'fri':'fri';\n  return lead ? `<span class=\"pill ${c}\">${lead}</span>` : '<span class=\"muted\">—</span>';\n}\nfunction saldoCell(n){\n  const cls = n<=1?'low':n<=2?'mid':'';\n  return `<span class=\"saldo ${cls}\">${n}</span>`;\n}\nfunction renderCards(){\n  const r=state.resumen||{};\n  const el=document.getElementById('cards'); el.innerHTML='';\n  const total=Object.values(r).reduce((a,b)=>a+b,0);\n  const order=[['Total',total],...Object.entries(r)];\n  for(const [k,v] of order){\n    const d=document.createElement('div'); d.className='card';\n    d.innerHTML=`<div class=\"n\">${v}</div><div class=\"l\">${k}</div>`; el.appendChild(d);\n  }\n}\nfunction renderPaquetes(){\n  const rows=[...state.paquetes].sort((a,b)=>a.clases-b.clases);\n  const el=document.getElementById('paquetes');\n  if(!rows.length){ el.innerHTML='<div class=\"empty\">Sin clientes de paquete.</div>'; return; }\n  el.innerHTML=`<table><thead><tr><th>Nombre</th><th>Teléfono</th><th>Clases restantes</th><th>Lead</th><th>Último contacto</th></tr></thead><tbody>${\n    rows.map(p=>`<tr><td>${p.nombre||'—'}</td><td>${p.telefono||'—'}</td><td>${saldoCell(p.clases)}</td><td>${pill(p.lead)}</td><td class=\"muted\">${p.ultimo||'—'}</td></tr>`).join('')\n  }</tbody></table>`;\n}\nfunction renderOtros(){\n  const ft=document.getElementById('fTipo').value, fl=document.getElementById('fLead').value;\n  const rows=state.otros.filter(o=>(!ft||o.tipo===ft)&&(!fl||o.lead===fl));\n  const el=document.getElementById('otros');\n  if(!rows.length){ el.innerHTML='<div class=\"empty\">Sin contactos.</div>'; return; }\n  el.innerHTML=`<table><thead><tr><th>Nombre</th><th>Teléfono</th><th>Servicio</th><th>Lead</th><th>Seguimiento</th><th>Último contacto</th></tr></thead><tbody>${\n    rows.map(o=>`<tr><td>${o.nombre||'—'}</td><td>${o.telefono||'—'}</td><td>${o.tipo||'—'}</td><td>${pill(o.lead)}</td><td class=\"muted\">${o.seguimiento||'—'}</td><td class=\"muted\">${o.ultimo||'—'}</td></tr>`).join('')\n  }</tbody></table>`;\n}\nfunction fillFilters(){\n  const tipos=[...new Set(state.otros.map(o=>o.tipo).filter(Boolean))];\n  const leads=[...new Set([...state.paquetes,...state.otros].map(o=>o.lead).filter(Boolean))];\n  const ft=document.getElementById('fTipo'), fl=document.getElementById('fLead');\n  ft.innerHTML='<option value=\"\">Todos los servicios</option>'+tipos.map(t=>`<option>${t}</option>`).join('');\n  fl.innerHTML='<option value=\"\">Todos los leads</option>'+leads.map(l=>`<option>${l}</option>`).join('');\n}\nasync function load(){\n  document.getElementById('ts').textContent='Cargando…';\n  try{\n    const r=await fetch(DATA); state=await r.json();\n    renderCards(); renderPaquetes(); fillFilters(); renderOtros();\n    document.getElementById('ts').textContent='Datos del Google Sheet · actualizado ahora';\n  }catch(e){ document.getElementById('ts').textContent='⚠️ Error al cargar datos.'; }\n}\ndocument.getElementById('refresh').onclick=load;\ndocument.getElementById('fTipo').onchange=renderOtros;\ndocument.getElementById('fLead').onchange=renderOtros;\nload();\n</script>\n</body>\n</html>\n","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}}}}],"connections":{"Webhook datos":{"main":[[{"node":"Leer Sheet","type":"main","index":0}]]},"Leer Sheet":{"main":[[{"node":"Agrupar","type":"main","index":0}]]},"Webhook pagina":{"main":[[{"node":"Servir HTML","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","saveDataErrorExecution":"all","saveDataSuccessExecution":"all","saveManualExecutions":true,"saveExecutionProgress":true},"staticData":null,"meta":null,"pinData":null,"versionId":"7171f956-dc0a-4ee8-8a38-ef0cd4fdd088","activeVersionId":null,"versionCounter":5,"triggerCount":2,"shared":[{"updatedAt":"2026-06-30T20:49:20.499Z","createdAt":"2026-06-30T20:49:20.499Z","role":"workflow:owner","workflowId":"6QMFduaiUqYWdu9s","projectId":"rZRkeAm6GVLmUxof","project":{"updatedAt":"2026-02-19T01:59:56.136Z","createdAt":"2026-02-19T01:58:26.855Z","id":"rZRkeAm6GVLmUxof","name":"Ferney Rojas <feruroc@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"6946a55e-46ec-4681-8c93-c318c39503c8"}}],"tags":[],"activeVersion":null}