{"updatedAt":"2026-05-19T16:46:09.522Z","createdAt":"2026-05-19T16:46:09.522Z","id":"SB10zprJRSAjEbTH","name":"Luxe Smile — CRM Exploration (test endpoints)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"trigger","name":"Manual Trigger","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[240,400],"parameters":{}},{"id":"gen-test-data","name":"Generar datos de prueba","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,400],"parameters":{"language":"javaScript","jsCode":"// Datos claramente identificables como test\nconst now = new Date();\nconst stamp = now.toISOString().replace(/[^0-9]/g, '').slice(0, 14);\nconst phone = `+99${stamp}`;\nreturn [{\n  json: {\n    nombre: `TEST EXPLORATION ${stamp} — DELETE`,\n    telefono: phone,\n    fuente: 'WhatsApp',\n    closer: 'Hernan Lopez',\n    notas: 'Lead de exploración del API. Borrar después de la prueba.',\n    timestamp: now.toISOString()\n  }\n}];"}},{"id":"test1-post-leads","name":"TEST 1: POST /leads (mínimo)","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[680,400],"parameters":{"method":"POST","url":"https://ayozqkwmpwdqxiggvrnq.supabase.co/functions/v1/api-v1/leads","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({\n  nombre: $json.nombre,\n  telefono: $json.telefono,\n  fuente: $json.fuente,\n  closer: $json.closer,\n  notas: $json.notas\n}) }}","options":{}},"credentials":{"httpHeaderAuth":{"id":"bdFoVsi2qdFV3fvT","name":"Luxe Smile - CRM API"}},"onError":"continueRegularOutput","notes":"Crea un lead con datos mínimos. Ver respuesta para conocer el shape (¿qué id devuelve?, ¿qué campos default agrega?)."},{"id":"extract-lead-id","name":"Extraer lead_id","type":"n8n-nodes-base.code","typeVersion":2,"position":[900,400],"parameters":{"language":"javaScript","jsCode":"// Intentar extraer el lead_id de la respuesta\nconst response = $input.first().json;\nconst leadData = response?.data?.item || response?.data || {};\nconst leadId = leadData.id || leadData.lead_id || null;\nconst telefono = leadData.telefono || $('Generar datos de prueba').first().json.telefono;\n\nreturn [{\n  json: {\n    lead_id: leadId,\n    telefono: telefono,\n    full_response: response,\n    found_id: leadId !== null\n  }\n}];"}},{"id":"test2-get-lead","name":"TEST 2: GET /leads/:id","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1120,250],"parameters":{"method":"GET","url":"=https://ayozqkwmpwdqxiggvrnq.supabase.co/functions/v1/api-v1/leads/{{ $json.lead_id }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"credentials":{"httpHeaderAuth":{"id":"bdFoVsi2qdFV3fvT","name":"Luxe Smile - CRM API"}},"onError":"continueRegularOutput","notes":"Verifica que el lead se creó. Vemos el shape completo de un lead."},{"id":"test3-patch-lead","name":"TEST 3: PATCH /leads/:id (procedimientos)","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1120,400],"parameters":{"method":"PATCH","url":"=https://ayozqkwmpwdqxiggvrnq.supabase.co/functions/v1/api-v1/leads/{{ $('Extraer lead_id').first().json.lead_id }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({\n  pipeline_stage: 'Cotizado',\n  monto_negociado: 5500,\n  carillas_superiores: 10,\n  carillas_inferiores: 10,\n  notas: 'Test PATCH — agregando procedimientos'\n}) }}","options":{}},"credentials":{"httpHeaderAuth":{"id":"bdFoVsi2qdFV3fvT","name":"Luxe Smile - CRM API"}},"onError":"continueRegularOutput","notes":"Prueba PATCH con procedimientos, monto y pipeline_stage. Confirma que el campo pipeline_stage acepta 'Cotizado' (resp