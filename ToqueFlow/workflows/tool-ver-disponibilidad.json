      "parameters": {
        "jsCode": "// De qué instancia viene y qué servicio pregunta. El company_id NUNCA viene\n// del payload: se deriva adentro de la base, como en todas las herramientas.\nconst b = $input.first().json.body || $input.first().json;\nconst dias = Number(b.dias);\nreturn [{ json: {\n  instance: String(b.instance || ''),\n  servicio: (b.servicio == null || String(b.servicio).trim() === '') ? null : String(b.servicio).trim(),\n  // Dos semanas por defecto. Más allá el negocio todavía no sabe qué va a\n  // hacer, y la lista se vuelve tan larga que el modelo se pierde en ella.\n  dias: Number.isFinite(dias) && dias > 0 ? Math.min(dias, 30) : 14,\n}}];"
      },
      "id": "tool-ver-disponibilidad-extraer",
      "name": "Extraer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.tf_tool_ver_disponibilidad($1, $2, $3::int) as resultado;",
        "options": {
          "queryReplacement": "={{ [ $json.instance, $json.servicio, $json.dias ] }}"
        }
      },
