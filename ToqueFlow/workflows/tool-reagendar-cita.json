{
  "name": "ToqueFlow - Tool Mover la cita",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tool-reagendar-cita",
        "responseMode": "lastNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "rg-entrada",
      "name": "Entrada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "VAQkH3v2R6czijkV",
          "name": "Toque - Firma del agente 2026-08-28"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La herramienta recibe lo que el agente le paso, mas de que instancia viene\n// y a quien atiende. NUNCA recibe el company_id: se deriva adentro de la base.\n// Si una herramienta aceptara la empresa del payload, bastaria un error en el\n// agente para tocarle los datos a otro cliente.\nconst b = $input.first().json.body || $input.first().json;\n\n// Todo va como UN jsonb: el nodo de Postgres parte los parametros por coma, y\n// aqui viaja una fecha con zona horaria que lleva signos.\nconst payload = Object.assign({}, b);\npayload.instance = String(b.instance || '');\npayload.telefono = String(b.telefono || '').replace(/\\D/g, '');\n\nreturn [{ json: { payload: JSON.stringify(payload) } }];"
      },
      "id": "rg-extraer",
      "name": "Extraer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.tf_tool_reagendar_cita($1::jsonb) as resultado;",
        "options": {
          "queryReplacement": "={{ [ $json.payload ] }}"
        }
      },
      "id": "rg-bd",
      "name": "Ejecutar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        40,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "ybgnIi1YfqZ3UpVX",
          "name": "Toque - Supabase Postgres (n8n_worker)"
        }
      }
    }
  ],
  "connections": {
    "Entrada": {
      "main": [
        [
          {
            "node": "Extraer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer": {
      "main": [
        [
          {
            "node": "Ejecutar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "timezone": "America/Bogota",
    "errorWorkflow": "Hjg94IM97CaNuEGp"
  }
}
